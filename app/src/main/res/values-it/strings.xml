    <!-- Dettagli AppOps di destinazione -->
    <string name="op_body_sensors_title">Sensori corporei e di movimento</string>
    <string name="op_body_sensors_desc">Controlla l\'accesso ad accelerometro, giroscopio, frequenza cardiaca e sensori di movimento.\nImposta su IGNORE: blocca silenziosamente l\'accesso restituendo letture vuote senza far arrestare l\'app (es. blocca azioni attivate scuotendo).</string>
    <string name="op_high_sampling_sensors_title">Sensori ad alta frequenza</string>
    <string name="op_high_sampling_sensors_desc">Controlla il campionamento dei sensori di movimento (giroscopio, accelerometro) oltre 200 Hz.\nImposta su IGNORE: limita il campionamento a frequenze normali senza crash, prevenendo il tracciamento preciso ad alta frequenza.</string>
    <string name="op_body_sensors_bg_title">Sensori corporei in background</string>
    <string name="op_body_sensors_bg_desc">Controlla se l\'app può continuare a leggere i sensori corporei e di movimento in background.\nImposta su IGNORE: interrompe l\'invio dei dati quando l\'app lascia il primo piano mantenendo l\'uso normale in primo piano.</string>
    <string name="op_activity_rec_title">Riconoscimento attività</string>
    <string name="op_activity_rec_desc">Controlla l\'accesso allo stato di attività fisica rilevato dal sistema (camminata, corsa, bici, conteggio passi).\nImposta su IGNORE: non restituisce aggiornamenti senza crash, impedendo il tracciamento di movimenti e passi.</string>
    <string name="op_read_clipboard_title">Leggi appunti</string>
    <string name="op_read_clipboard_desc">Controlla la lettura di testo, link, immagini e altri contenuti copiati negli appunti di sistema.\nImposta su IGNORE: restituisce silenziosamente appunti vuoti senza crash, impedendo lo spionaggio in background.</string>
    <string name="op_write_clipboard_title">Scrivi negli appunti</string>
    <string name="op_write_clipboard_desc">Controlla la scrittura, modifica o sovrascrittura di dati negli appunti di sistema.\nImposta su IGNORE: scarta silenziosamente le richieste di scrittura mantenendo intatto il contenuto attuale.</string>
    <string name="op_query_packages_title">Leggi pacchetti installati</string>
    <string name="op_query_packages_desc">Controlla l\'interrogazione dell\'elenco delle app installate, nomi dei pacchetti e metadati sul dispositivo.\nImposta su IGNORE: nasconde le altre app installate (restituendo risultati minimi o vuoti) senza errori, riducendo la profilazione.</string>
    <string name="op_usage_stats_title">Statistiche di utilizzo</string>
    <string name="op_usage_stats_desc">Controlla l\'accesso alla cronologia di utilizzo delle app, frequenza di avvio e app attive.\nImposta su IGNORE: restituisce una cronologia vuota senza errori, impedendo di monitorare come e quando usi altre app.</string>
    <string name="op_run_in_bg_title">Esegui in background</string>
    <string name="op_run_in_bg_desc">Controlla se l\'app può eseguire servizi in background, attività pianificate e traffico di rete fuori dal primo piano.\nImposta su IGNORE: limita servizi e rete in background quando l\'app non è in primo piano, risparmiando batteria e dati.</string>
    <string name="op_wake_lock_title">Mantieni WakeLock</string>
    <string name="op_wake_lock_desc">Controlla la richiesta di blocchi energetici per mantenere la CPU attiva o impedire lo spegnimento dello schermo.\nImposta su IGNORE: ignora silenziosamente le richieste di WakeLock consentendo al dispositivo di andare in sospensione normale.</string>
    <string name="op_system_alert_title">Mostra sopra altre app (Sovrapposizione)</string>
    <string name="op_system_alert_desc">Controlla il disegno di finestre mobili, overlay e livelli interattivi sopra altre app o l\'interfaccia di sistema.\nImposta su IGNORE: impedisce di mostrare sovrapposizioni o popup sopra altre app senza crash.</string>
    <string name="op_write_settings_title">Modifica impostazioni di sistema</string>
    <string name="op_write_settings_desc">Controlla la modifica delle impostazioni globali di sistema come luminosità, timeout schermo, suonerie e volume.\nImposta su IGNORE: scarta silenziosamente i tentativi di modifica mantenendo il normale funzionamento dell\'app.</string>
    <string name="op_access_notif_title">Accesso alle notifiche</string>
    <string name="op_access_notif_desc">Controlla la lettura delle notifiche pubblicate da tutte le app, inclusi titoli, testo e pulsanti di azione.\nImposta su IGNORE: impedisce all\'app di ricevere notifiche di altre app senza crash, proteggendo i contenuti sensibili.</string>
    <string name="op_run_any_in_bg_title">Attività illimitata in background</string>
    <string name="op_run_any_in_bg_desc">Controlla se l\'app può funzionare liberamente in background (criterio principale Android 9+, sincronizzato con la limitazione batteria).\nImposta su IGNORE: impone lo stato con limitazioni in background risparmiando batteria.</string>
