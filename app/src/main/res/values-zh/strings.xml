    <!-- 敏感权限详细说明 -->
    <string name="op_body_sensors_title">运动与身体传感器</string>
    <string name="op_body_sensors_desc">设为IGNORE从物理层静默拦截加速度计等传感器访问</string>
    <string name="op_high_sampling_sensors_title">高采样率运动传感器</string>
    <string name="op_high_sampling_sensors_desc">限制陀螺仪与加速度计超高频刷新，防止微小晃动与高频状态探测</string>
    <string name="op_body_sensors_bg_title">后台运动传感器</string>
    <string name="op_body_sensors_bg_desc">禁止退到后台后继续读取运动状态</string>
    <string name="op_activity_rec_title">健身与活动识别</string>
    <string name="op_activity_rec_desc">防止App探测走路、跑步或手机晃动状态</string>
    <string name="op_read_clipboard_title">读取剪贴板</string>
    <string name="op_read_clipboard_desc">设为IGNORE后App读剪贴板将返回空内容，彻底杜绝淘口令偷窥</string>
    <string name="op_write_clipboard_title">写入剪贴板</string>
    <string name="op_write_clipboard_desc">禁止流氓SDK后台静默覆盖用户当前剪贴板内容</string>
    <string name="op_query_packages_title">读取已安装应用列表</string>
    <string name="op_query_packages_desc">设为IGNORE切断全机画像追踪，禁止扫描安装的银行、游戏或竞品软件</string>
    <string name="op_usage_stats_title">使用情况统计</string>
    <string name="op_usage_stats_desc">剥夺App偷窥“你当前正在使用什么其他App”的能力</string>
    <string name="op_run_in_bg_title">后台运行权限</string>
    <string name="op_run_in_bg_desc">退到后台即刻挂起冻结，杜绝隐蔽保活消耗电池与流量</string>
    <string name="op_wake_lock_title">保持唤醒锁 (WakeLock)</string>
    <string name="op_wake_lock_desc">剥夺持有CPU唤醒锁的能力，防止发热暗耗电</string>
    <string name="op_system_alert_title">显示在其他应用上层 (悬浮窗)</string>
    <string name="op_system_alert_desc">彻底关闭流氓弹窗与防范透明点击劫持 (Clickjacking)</string>
    <string name="op_write_settings_title">修改系统设置</string>
    <string name="op_write_settings_desc">防止未经允许篡改系统音量、亮度、屏幕常亮或网络</string>
    <string name="op_access_notif_title">全局通知监听</string>
    <string name="op_access_notif_desc">审查并阻断偷读全局通知栏消息（防止盗取短信验证码）</string>

