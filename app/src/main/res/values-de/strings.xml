    <!-- Ziel-AppOps-Details -->
    <string name="op_body_sensors_title">Körper- &amp; Bewegungssensoren</string>
    <string name="op_body_sensors_desc">Steuert den Zugriff auf Beschleunigungs-, Gyroskop-, Herzfrequenz- und Bewegungssensoren.\nAuf IGNORE setzen: Blockiert den Sensorzugriff stillschweigend und gibt leere Werte zurück, ohne die App zum Absturz zu bringen (stoppt z. B. Schüttel-Aktionen).</string>
    <string name="op_high_sampling_sensors_title">Sensoren mit hoher Abtastrate</string>
    <string name="op_high_sampling_sensors_desc">Steuert die Abtastung von Bewegungssensoren (wie Gyroskop und Beschleunigungssensor) über 200 Hz.\nAuf IGNORE setzen: Begrenzt die Abtastrate auf normale Frequenzen ohne Absturz und verhindert präzises Hochfrequenz-Tracking.</string>
    <string name="op_body_sensors_bg_title">Körpersensoren im Hintergrund</string>
    <string name="op_body_sensors_bg_desc">Steuert, ob die App im Hintergrund weiterhin Körper- und Bewegungssensordaten lesen darf.\nAuf IGNORE setzen: Stoppt die Datenübermittlung im Hintergrund beim Verlassen des Vordergrunds bei normaler Vordergrundnutzung.</string>
    <string name="op_activity_rec_title">Aktivitätserkennung</string>
    <string name="op_activity_rec_desc">Steuert den Zugriff auf den vom System erkannten Bewegungszustand wie Gehen, Laufen, Radfahren oder Schrittzahlen.\nAuf IGNORE setzen: Liefert keine Aktivitätsupdates ohne Absturz und verhindert Bewegungs- und Schritt-Tracking.</string>
    <string name="op_read_clipboard_title">Zwischenablage lesen</string>
    <string name="op_read_clipboard_desc">Steuert das Lesen von Texten, Links, Bildern und anderen Inhalten in der Systemzwischenablage.\nAuf IGNORE setzen: Gibt stillschweigend eine leere Zwischenablage ohne Absturz zurück und verhindert Hintergrund-Ausspähen.</string>
    <string name="op_write_clipboard_title">In Zwischenablage schreiben</string>
    <string name="op_write_clipboard_desc">Steuert das Schreiben, Ändern oder Überschreiben von Texten und Daten in der Systemzwischenablage.\nAuf IGNORE setzen: Verwirft Schreibanfragen stillschweigend, sodass Ihre bestehende Zwischenablage unverändert bleibt.</string>
    <string name="op_query_packages_title">Installierte Pakete lesen</string>
    <string name="op_query_packages_desc">Steuert das Abfragen der Liste installierter Apps, Paketnamen und Metadaten auf diesem Gerät.\nAuf IGNORE setzen: Verbirgt andere installierte Apps (minimale oder leere Ergebnisse) ohne Absturz und reduziert App-übergreifendes Profiling.</string>
    <string name="op_usage_stats_title">Nutzungsstatistiken</string>
    <string name="op_usage_stats_desc">Steuert den Zugriff auf den App-Nutzungsverlauf, Starthäufigkeit und aktive Anwendungen.\nAuf IGNORE setzen: Gibt einen leeren Nutzungsverlauf ohne Fehler zurück und verhindert die Überwachung anderer Apps.</string>
    <string name="op_run_in_bg_title">Im Hintergrund ausführen</string>
    <string name="op_run_in_bg_desc">Steuert, ob die App Hintergrunddienste, geplante Aufgaben und Netzwerkaktivität außerhalb des Vordergrunds ausführen darf.\nAuf IGNORE setzen: Unterdrückt Hintergrunddienste und Netzwerkaktivität beim Verlassen des Vordergrunds und spart Akku sowie Daten.</string>
    <string name="op_wake_lock_title">WakeLock halten</string>
    <string name="op_wake_lock_desc">Steuert das Anfordern von Energie-WakeLocks, um die CPU aktiv zu halten oder den Bildschirm am Ausschalten zu hindern.\nAuf IGNORE setzen: Ignoriert WakeLock-Anfragen stillschweigend, sodass das Gerät normal in den Ruhezustand geht.</string>
    <string name="op_system_alert_title">Über anderen Apps einblenden (Overlay)</string>
    <string name="op_system_alert_desc">Steuert das Zeichnen schwebender Fenster, Overlays und interaktiver Ebenen über anderen Apps oder der Systemoberfläche.\nAuf IGNORE setzen: Verhindert schwebende Overlays und Popups über anderen Apps ohne Absturz.</string>
    <string name="op_write_settings_title">Systemeinstellungen ändern</string>
    <string name="op_write_settings_desc">Steuert das Ändern globaler Systemeinstellungen wie Bildschirmhelligkeit, Timeout, Klingeltöne und Lautstärke.\nAuf IGNORE setzen: Verwirft Änderungen an globalen Systemeinstellungen stillschweigend bei normalem App-Betrieb.</string>
    <string name="op_access_notif_title">Benachrichtigungszugriff</string>
    <string name="op_access_notif_desc">Steuert das Lesen von Benachrichtigungen aller Apps einschließlich Titel, Text und Aktionsschaltflächen.\nAuf IGNORE setzen: Blockiert den Empfang von Benachrichtigungen anderer Apps ohne Absturz und schützt vertrauliche Inhalte.</string>
    <string name="op_run_any_in_bg_title">Uneingeschränkte Hintergrundaktivität</string>
    <string name="op_run_any_in_bg_desc">Steuert, ob die App frei im Hintergrund laufen darf (primäre Hintergrundrichtlinie ab Android 9, synchron mit der Akku-Einschränkung).\nAuf IGNORE setzen: Versetzt die App in den eingeschränkten Hintergrundzustand und spart Akku.</string>
